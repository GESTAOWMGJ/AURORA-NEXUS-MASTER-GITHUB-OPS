# Nenhuma conexão externa é feita no modo disabled.
JFN_INTEGRATION_MODE=disabled
# Para homologação: homologation. Produção não é aceita nesta versão.
JFN_ALLOWED_ORGS=
WMGJ_CONTROL_PLANE_ORIGIN=
# Configuração pública do Firebase Web App DE HOMOLOGAÇÃO; não é chave Admin.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Nunca adicionar private_key, HMAC, ADC ou credenciais bancárias aqui.
