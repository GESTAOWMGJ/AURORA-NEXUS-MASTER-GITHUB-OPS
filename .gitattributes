# Keep the installed knowledge adapter byte-compatible on Windows checkouts.
desktop/ia-master/knowledge-registry.cjs text eol=lf
# Preserve the upstream license bytes, including its original trailing space.
firebase-migration/hosting/aurora-nexus/assets/fonts/*.txt text eol=lf
firebase-migration/hosting/aurora-nexus/assets/fonts/provenance.json text eol=lf
firebase-migration/hosting/aurora-nexus/assets/fonts/Atkinson-Hyperlegible-Next-OFL.txt -whitespace
# Shared generated intake assets retain the exact compiler/manifest bytes.
aurora-coletor/document_intake*.cjs text eol=lf
aurora-coletor/document_fact_mapping.cjs text eol=lf
aurora-coletor/document_intake.py text eol=lf
aurora-coletor/document-intake-manifest.json text eol=lf

# Public institutional CREDMED media must preserve exact SHA-256 across Windows/Linux.
firebase-migration/hosting/aurora-nexus/arquivos/wmgj/*.pdf binary
firebase-migration/hosting/aurora-nexus/arquivos/wmgj/*.mp4 binary
