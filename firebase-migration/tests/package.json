{
  "name": "wmgj-firestore-rule-tests",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tooling-dependencies.test.mjs firestore.rules.test.mjs",
    "test:tooling": "node --test tooling-dependencies.test.mjs",
    "test:rules": "firebase emulators:exec --config ../firebase.json --project wmgj-firestore-rules-test --only firestore \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.18.0",
    "firebase-tools": "15.34.0"
  },
  "overrides": {
    "@opentelemetry/core": "2.8.0",
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.13.6"
    },
    "gaxios": {
      "uuid": "11.1.1"
    }
  }
}
