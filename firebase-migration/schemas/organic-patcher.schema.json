{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.local/schemas/organic-patcher.v1.schema.json",
  "title": "AURORA NEXUS Organic Patcher Manifest v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "manifestId",
    "orgId",
    "clientSkillId",
    "platform",
    "baseVersion",
    "clientVersion",
    "mode",
    "environment",
    "executionMode",
    "activationAllowed",
    "patches",
    "security",
    "audit"
  ],
  "properties": {
    "schemaVersion": {
      "const": "aurora.organic.patcher.manifest.v1"
    },
    "manifestId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120
    },
    "orgId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "clientSkillId": {
      "type": "string",
      "minLength": 4,
      "maxLength": 120,
      "pattern": "^aurora-client-[a-z0-9_-]+$"
    },
    "platform": {
      "type": "string",
      "enum": [
        "web",
        "pwa",
        "desktop-macos",
        "desktop-windows",
        "ios",
        "android",
        "wrapper"
      ]
    },
    "baseVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "clientVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "mode": {
      "type": "string",
      "enum": [
        "trial",
        "contracted"
      ]
    },
    "environment": {
      "type": "string",
      "enum": [
        "hml",
        "production"
      ]
    },
    "executionMode": {
      "const": "READ_ONLY"
    },
    "activationAllowed": {
      "const": false
    },
    "patches": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "patchId",
          "module",
          "reason",
          "operationNeed",
          "status",
          "requiresHumanReview",
          "definitionFingerprint",
          "evidenceRefs",
          "allowedSurfaces"
        ],
        "properties": {
          "patchId": {
            "type": "string",
            "minLength": 4,
            "maxLength": 120
          },
          "module": {
            "type": "string",
            "enum": [
              "client_operation_skill",
              "gmail_domain_indexer_lgpd",
              "document_sanitation",
              "communication_robot",
              "billing_chain",
              "glosa_recovery",
              "money_drain_panel",
              "service_insight",
              "trial_friction_metrics",
              "notification_engine",
              "ui_dashboard",
              "audit_trail"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "operationNeed": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "synthetic_tested",
              "waiting_human_review",
              "pilot_approved",
              "blocked",
              "rollback_recommended",
              "rolled_back"
            ]
          },
          "requiresHumanReview": {
            "const": true
          },
          "definitionFingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "allowedSurfaces": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "web",
                "pwa",
                "desktop-macos",
                "desktop-windows",
                "ios",
                "android",
                "backend-only"
              ]
            }
          },
          "approval": {
            "type": "object",
            "required": [
              "revision",
              "actorUid",
              "planFingerprint"
            ],
            "properties": {
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "actorUid": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "planFingerprint": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "pilot_approved"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "approval"
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "security": {
      "type": "object",
      "required": [
        "requiresAuth",
        "requiresMfaForReview",
        "requiresAppCheck",
        "noClientSecrets",
        "denyByDefault",
        "lgpdScopeRequired",
        "backendOnlySensitiveActions"
      ],
      "properties": {
        "requiresAuth": {
          "const": true
        },
        "requiresMfaForReview": {
          "const": true
        },
        "requiresAppCheck": {
          "const": true
        },
        "noClientSecrets": {
          "const": true
        },
        "denyByDefault": {
          "const": true
        },
        "lgpdScopeRequired": {
          "const": true
        },
        "backendOnlySensitiveActions": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "required": [
        "createdAt",
        "createdBy",
        "hashAlgorithm",
        "hash",
        "rollbackPolicy"
      ],
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "hashAlgorithm": {
          "const": "SHA-256"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rollbackPolicy": {
          "const": "not_applicable_read_only"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
