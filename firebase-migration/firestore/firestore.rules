rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function organizationPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId);
    }

    function activeOrganization(orgId) {
      return exists(organizationPath(orgId))
        && get(organizationPath(orgId)).data.active == true;
    }

    function memberPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid);
    }

    function member(orgId) {
      return signedIn() && exists(memberPath(orgId))
        ? get(memberPath(orgId)).data
        : null;
    }

    function activeMember(orgId) {
      return signedIn()
        && activeOrganization(orgId)
        && exists(memberPath(orgId))
        && member(orgId).active == true;
    }

    function roleIn(orgId, roles) {
      return activeMember(orgId)
        && member(orgId).role is string
        && member(orgId).role in roles;
    }

    function hasPermission(orgId, permission) {
      return activeMember(orgId)
        && member(orgId).keys().hasAll(['permissions'])
        && member(orgId).permissions is list
        && permission in member(orgId).permissions;
    }

    function allFacilities(orgId) {
      return activeMember(orgId)
        && member(orgId).keys().hasAll(['allFacilities'])
        && member(orgId).allFacilities == true;
    }

    function hasFacilityList(orgId) {
      return activeMember(orgId)
        && member(orgId).keys().hasAll(['facilityIds'])
        && member(orgId).facilityIds is list;
    }

    // Fail-closed: projeções sem facilityId são organizacionais e exigem escopo
    // global. Membros limitados só recebem documentos com facilityId explícito.
    function facilityAllowed(orgId, data) {
      return activeMember(orgId)
        && (
          allFacilities(orgId)
          || (
            'facilityId' in data
            && data.facilityId is string
            && hasFacilityList(orgId)
            && data.facilityId in member(orgId).facilityIds
          )
        );
    }

    function canReadRawSources(orgId) {
      return roleIn(orgId, ['platform_admin', 'org_admin', 'auditor'])
        || hasPermission(orgId, 'sources.raw.read');
    }

    function canReadOperational(orgId) {
      return roleIn(orgId, [
        'platform_admin', 'org_admin', 'director', 'auditor', 'operator'
      ]) || hasPermission(orgId, 'operations.read');
    }

    function canReadFinancial(orgId) {
      return roleIn(orgId, [
        'platform_admin', 'org_admin', 'director', 'auditor', 'finance'
      ]) || hasPermission(orgId, 'financial.read');
    }

    function canReadHospital(orgId) {
      return roleIn(orgId, [
        'platform_admin', 'org_admin', 'director', 'auditor', 'medical_auditor'
      ]) || hasPermission(orgId, 'hospital.read');
    }

    function canReadClinical(orgId) {
      return roleIn(orgId, [
        'platform_admin', 'org_admin', 'auditor', 'medical_auditor'
      ]) || hasPermission(orgId, 'clinical.read');
    }

    function canReadAudit(orgId) {
      return roleIn(orgId, [
        'platform_admin', 'org_admin', 'director', 'auditor'
      ]) || hasPermission(orgId, 'audit.read');
    }

    function canReadActions(orgId) {
      return canReadOperational(orgId)
        || canReadFinancial(orgId)
        || canReadHospital(orgId)
        || hasPermission(orgId, 'actions.read');
    }

    function sourceDocument(orgId, documentId) {
      return get(
        /databases/$(database)/documents/organizations/$(orgId)/sourceDocuments/$(documentId)
      ).data;
    }

    match /organizations/{orgId} {
      allow get: if activeMember(orgId);
      allow list, create, update, delete: if false;

      match /members/{uid} {
        allow get: if activeMember(orgId)
          && (
            request.auth.uid == uid
            || roleIn(orgId, ['platform_admin', 'org_admin', 'auditor'])
            || hasPermission(orgId, 'members.read')
          );
        allow list: if roleIn(orgId, ['platform_admin', 'org_admin', 'auditor'])
          || hasPermission(orgId, 'members.read');
        allow create, update, delete: if false;
      }

      match /facilities/{facilityId} {
        allow read: if activeMember(orgId);
        allow write: if false;
      }

      // Metadados/documentos-fonte podem conter conteúdo restrito. Viewer não
      // recebe acesso implícito; é necessário papel privilegiado ou permissão.
      match /sourceDocuments/{documentId} {
        allow read: if canReadRawSources(orgId)
          && facilityAllowed(orgId, resource.data);
        allow write: if false;

        match /versions/{versionId} {
          allow read: if canReadRawSources(orgId)
            && facilityAllowed(orgId, sourceDocument(orgId, documentId));
          allow write: if false;
        }

        match /events/{eventId} {
          allow read: if canReadAudit(orgId)
            && facilityAllowed(orgId, sourceDocument(orgId, documentId));
          allow write: if false;
        }
      }

      match /{collection}/{documentId} {
        allow read: if collection in [
          'professionals', 'shifts', 'productivityRecords',
          'runtimeCheckpoints', 'managerInputs'
        ]
          && canReadOperational(orgId)
          && facilityAllowed(orgId, resource.data);
        allow write: if false;
      }

      match /{collection}/{documentId} {
        allow read: if collection in [
          'periods', 'contracts', 'contractRules', 'invoices',
          'bankTransactions', 'financialEntries', 'taxObligations',
          'reconciliations', 'monthlyClosings'
        ]
          && canReadFinancial(orgId)
          && facilityAllowed(orgId, resource.data);
        allow write: if false;
      }

      match /{collection}/{documentId} {
        allow read: if collection in [
          'hospitalAccounts', 'authorizations', 'billingItems', 'glosses',
          'appeals', 'opmeItems', 'qualityIndicators', 'auditFindings'
        ]
          && canReadHospital(orgId)
          && facilityAllowed(orgId, resource.data);
        allow write: if false;
      }

      match /clinicalEvidence/{evidenceId} {
        allow read: if canReadClinical(orgId)
          && facilityAllowed(orgId, resource.data);
        allow write: if false;
      }

      // Projeções são servidas exclusivamente pelo BFF/Functions após RBAC e
      // sanitização. O SDK cliente não acessa snapshots diretamente.
      match /dashboardSnapshots/{snapshotId} {
        allow read, write: if false;
      }

      // Comandos humanos passam pelo FastAPI/Admin SDK. O cliente apenas lê.
      match /actionItems/{actionId} {
        allow read: if canReadActions(orgId)
          && facilityAllowed(orgId, resource.data);
        allow create, update, delete: if false;
      }

      match /approvals/{approvalId} {
        allow read: if canReadActions(orgId)
          && facilityAllowed(orgId, resource.data);
        allow write: if false;
      }

      match /auditEvents/{eventId} {
        allow read: if canReadAudit(orgId)
          && facilityAllowed(orgId, resource.data);
        allow write: if false;
      }

      // Histórico imutável de cada versão aceita pela ingestão. O conteúdo pode
      // conter dados financeiros/operacionais e permanece restrito ao backend
      // Admin SDK; clientes usam auditEvents e projeções sanitizadas.
      match /entityVersions/{versionId} {
        allow read, write: if false;
      }

      match /aiRuns/{runId} {
        allow read: if (
          canReadAudit(orgId)
          || canReadClinical(orgId)
          || hasPermission(orgId, 'ai.read')
        ) && facilityAllowed(orgId, resource.data);
        allow write: if false;
      }

      match /integrationEvents/{eventId} {
        allow read: if (
          roleIn(orgId, ['platform_admin', 'org_admin', 'auditor'])
          || hasPermission(orgId, 'integrations.read')
        ) && facilityAllowed(orgId, resource.data);
        allow write: if false;
      }

      match /workflowRuns/{runId} {
        allow read: if canReadOperational(orgId)
          && facilityAllowed(orgId, resource.data);
        allow write: if false;
      }

      match /runtimeLocks/{lockId} {
        allow read: if canReadOperational(orgId)
          && facilityAllowed(orgId, resource.data);
        allow write: if false;
      }

      match /deadLetters/{itemId} {
        allow read: if canReadOperational(orgId)
          && facilityAllowed(orgId, resource.data);
        allow write: if false;
      }

      // Tokens/chaves idempotentes da API nunca são expostos ao cliente.
      match /apiIdempotency/{idempotencyId} {
        allow read, write: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
