{
  "id": "AURORA-CREDENTIAL-CONTINUITY-001",
  "name": "Aurora Nexus Credential Continuity and Recovery",
  "version": "1.0.0",
  "date": "2026-10-14",
  "status": "ACTIVE_POLICY",
  "activeDevelopmentDeliverable": "2026.10.07-dev.2",
  "purpose": "Keep one identity, authorization and recovery plane across web, Windows, macOS, iOS/Android PWA, remote operators and physical devices without cloning secrets or creating platform-specific credential silos.",
  "identityPlane": {
    "singleCanonicalIdentityPlane": true,
    "provider": "FIREBASE_AUTHENTICATION",
    "canonicalUserEntry": "https://auroranexus.com.br/portal",
    "liveMembershipRequired": true,
    "organizationBindingRequired": true,
    "mfaPreservedAcrossPasswordReset": true,
    "localOperatingSystemLoginDoesNotBypassAuroraAuthorization": true
  },
  "platformRules": {
    "clientsAreInterfacesOfSameOrganism": true,
    "platforms": [
      "web",
      "windows",
      "macos",
      "ios_pwa",
      "android_pwa"
    ],
    "sameGovernanceAndAuthorizationContract": true,
    "platformSpecificCredentialDatabasesForbidden": true,
    "clientCredentialStorageForbidden": true,
    "browserProfileOrCookieCloningForbidden": true,
    "passwordOrTotpTransportByInstallerForbidden": true
  },
  "remoteAndPhysicalAccess": {
    "channels": [
      "desktop_commander",
      "triggercmd",
      "physical_console"
    ],
    "channelsAreTransportNotIdentityProviders": true,
    "channelPresenceDoesNotGrantAuroraAccess": true,
    "remoteCommandMayOpenCanonicalPortalButMustNotCarryPasswordsTotpOrRecoveryLinks": true,
    "newDeviceRequiresNativeReauthenticationOrGovernedRebind": true,
    "deviceIdentityMustNotBeCloned": true,
    "tokensPasswordsCookiesKeychainsAndCredentialVaultsMustNotBeCopiedBetweenDevices": true
  },
  "loginContinuity": {
    "normalizeEmailBeforeAuthentication": true,
    "sessionExchangeRetry": {
      "enabled": true,
      "attempts": 2,
      "onlyForNetworkOrServer5xx": true,
      "nonRetryableAuthorizationDenials": true
    },
    "sessionCookie": [
      "HttpOnly",
      "Secure",
      "SameSite=Strict"
    ],
    "liveRevocationCheckRequired": true,
    "userEnumerationForbidden": true,
    "distinguishTransientAvailabilityFromAuthorizationFailure": true
  },
  "passwordRecovery": {
    "sameIdentityProvider": true,
    "noApplicationApiReceivesPasswordOrOobCode": true,
    "emailNormalizationRequired": true,
    "localDuplicateRequestCooldownSeconds": 60,
    "transientFailureCooldownSeconds": 15,
    "accountEnumerationForbidden": true,
    "acceptedLinkScheme": "https",
    "acceptedHosts": [
      "auroranexus.com.br",
      "wmgj-hml-jfn-20260927.web.app",
      "wmgj-hml-jfn-20260927.firebaseapp.com"
    ],
    "exactSingleResetModeAndCodeRequired": true,
    "oobCodeMaxLength": 2048,
    "passwordResetMustNotRemoveMfa": true,
    "recoveryMaterialMemoryOnly": true,
    "recoveryQueryRemovedFromBrowserHistoryAfterCapture": true
  },
  "oneUseCredentials": {
    "onboardingCredentialMustNotBeReplayedAfterUncertainConsumption": true,
    "retryMustPreferSessionRecheckBeforeCredentialReplay": true
  },
  "installerRules": {
    "installerMayOpenCanonicalPortal": true,
    "installerMayNotCollectAuroraPassword": true,
    "installerMayNotCollectThirdPartyProviderPassword": true,
    "installerMayNotDisableOperatingSystemSecurityControls": true,
    "installationAndAuthenticationAreSeparateEvidenceStates": true
  },
  "auditAndRecovery": {
    "changesRequireTests": true,
    "rollbackOrSafeFallbackRequired": true,
    "credentialValuesMustNeverEnterLogsReceiptsOrRepository": true,
    "remotePhysicalWebAndMobileMustConvergeOnSameAuthorizationState": true
  }
}
