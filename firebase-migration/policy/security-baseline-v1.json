{
  "id": "AURORA-SEC-001",
  "name": "Aurora Nexus Security Baseline",
  "version": "1.0.0",
  "status": "DRAFT_ENFORCED_IN_CI",
  "dataClassification": [
    "PUBLIC",
    "INTERNAL",
    "RESTRICTED",
    "CLINICAL_SENSITIVE"
  ],
  "transport": {
    "minimumTls": "1.2",
    "preferredTls": "1.3",
    "rejectInvalidCertificates": true
  },
  "integrity": {
    "allowed": [
      "HMAC-SHA-256",
      "SHA-256",
      "SHA-384",
      "SHA-512"
    ],
    "hmacMinimumSecretBits": 256,
    "constantTimeMacComparison": true,
    "forbidden": [
      "MD5",
      "SHA-1_FOR_SECURITY",
      "DES",
      "3DES",
      "RC4",
      "AES-ECB"
    ]
  },
  "atRest": {
    "hmlNonSensitive": "GOOGLE_DEFAULT_ENCRYPTION_ALLOWED",
    "productionOrSensitive": "CMEK_REQUIRED_WHEN_FIRESTORE_FEATURE_IS_AVAILABLE_AND_APPROVED",
    "existingGoogleEncryptedDatabaseConvertibleToCmek": false,
    "migrationToCmek": [
      "CLONE_TO_NEW_DATABASE",
      "RESTORE_TO_NEW_DATABASE",
      "EXPORT_IMPORT_TO_NEW_DATABASE"
    ],
    "destructiveRecreateAuthorized": false
  },
  "applicationLayerEncryption": {
    "requiredFor": [
      "CLINICAL_SENSITIVE",
      "SELECTED_RESTRICTED"
    ],
    "algorithm": "AES-256-GCM",
    "dekBits": 256,
    "nonceBits": 96,
    "keyWrapping": "CLOUD_KMS_KEK",
    "keyProtectionHighestAssurance": "CLOUD_HSM_WHEN_REQUIRED_BY_RISK_OR_CONTRACT",
    "aadRequired": [
      "orgId",
      "entityType",
      "schemaVersion",
      "logicalFieldOrDocumentId"
    ],
    "deterministicEncryptionDefault": false
  },
  "keyManagement": {
    "kms": "GOOGLE_CLOUD_KMS",
    "secrets": "GOOGLE_SECRET_MANAGER",
    "ciIdentity": "OIDC_WIF",
    "persistentServiceAccountJsonAllowed": false,
    "automaticSymmetricRotationRequiredWhenSupported": true,
    "defaultInternalRotationTargetDays": 90,
    "emergencyRotationRequiredOnSuspectedExposure": true
  },
  "authentication": {
    "sharedAccountsAllowed": false,
    "mfaRequiredFor": [
      "PLATFORM_ADMIN",
      "ORG_ADMIN",
      "SECURITY_ADMIN",
      "PERMISSION_CHANGE",
      "HIGH_RISK_ACTION",
      "CRITICAL_RISK_ACTION"
    ],
    "backendMembershipRevalidation": true,
    "leastPrivilege": true
  },
  "databaseGates": [
    "DELETE_PROTECTION",
    "PITR",
    "SCHEDULED_BACKUP",
    "READY_BACKUP",
    "RESTORE_TEST_BEFORE_CUTOVER",
    "SECURITY_RULES_TESTED",
    "IAM_REVIEWED",
    "TENANT_ISOLATION_TESTED",
    "IDEMPOTENCY_TESTED",
    "CONCURRENCY_TESTED",
    "RETENTION_DEFINED",
    "CRYPTOGRAPHY_VERIFIED"
  ],
  "sdlc": {
    "required": [
      "HUMAN_REVIEW",
      "UNIT_INTEGRATION_TESTS",
      "STATIC_ANALYSIS",
      "CODEQL_OR_EQUIVALENT",
      "DEPENDENCY_REVIEW",
      "SECRET_SCANNING",
      "LOCKFILES",
      "SBOM_FOR_COMMERCIAL_RELEASE",
      "ARTIFACT_HASHES",
      "ROLLBACK"
    ],
    "unresolvedHighCriticalVulnerabilityBlocksRelease": true
  },
  "marketFrameworks": [
    "LGPD_ANPD",
    "ISO_IEC_27001_2022",
    "ISO_IEC_27701_2025",
    "NIST_CSF_2_0",
    "NIST_SP_800_218_SSDF_1_1",
    "OWASP_ASVS_5_0",
    "FIREBASE_SECURITY_CHECKLIST"
  ],
  "evidenceStates": [
    "SPECIFIED",
    "IMPLEMENTED",
    "TESTED",
    "CI_VERIFIED",
    "HML_VERIFIED",
    "PRODUCTION_VERIFIED",
    "AUDITED_INDEPENDENTLY",
    "CERTIFIED"
  ],
  "requiredMarketDocuments": [
    "ARCHITECTURE_DATA_FLOW",
    "ASSET_DATA_INVENTORY",
    "INFORMATION_SECURITY_POLICY",
    "ACCESS_CONTROL_POLICY",
    "CRYPTO_KEY_MANAGEMENT_POLICY",
    "SECURE_SDLC_POLICY",
    "VULNERABILITY_PATCH_POLICY",
    "THREAT_MODEL",
    "RISK_REGISTER",
    "ROPA",
    "DPIA_RIPD_WHEN_APPLICABLE",
    "RETENTION_DELETION_POLICY",
    "INCIDENT_RESPONSE_PLAN",
    "BCP_DR_PLAN",
    "BACKUP_RESTORE_EVIDENCE",
    "LOGGING_MONITORING_POLICY",
    "VENDOR_SUBPROCESSOR_REGISTER",
    "DATA_PROCESSING_AGREEMENT",
    "AI_GOVERNANCE_POLICY",
    "SBOM",
    "SECURITY_SCAN_REPORT",
    "INDEPENDENT_PENTEST_BEFORE_SENSITIVE_SCALE",
    "REMEDIATION_EVIDENCE",
    "ACCESS_REVIEW_MATRIX",
    "CHANGE_RELEASE_MANAGEMENT",
    "SLA_SLO_SUPPORT",
    "SECURITY_QUESTIONNAIRE_PACK",
    "TRUST_CENTER_OR_SECURITY_DOSSIER"
  ]
}
