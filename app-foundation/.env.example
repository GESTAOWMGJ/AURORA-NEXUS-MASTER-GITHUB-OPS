# Identificação pública do projeto Firebase. Não inserir chaves privadas neste arquivo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=wmgj-master-data-demo
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Em desenvolvimento local, conecta Auth/Firestore/Functions aos emuladores.
VITE_USE_FIREBASE_EMULATOR=true
VITE_DEMO_TENANT_ID=wmgj-demo
