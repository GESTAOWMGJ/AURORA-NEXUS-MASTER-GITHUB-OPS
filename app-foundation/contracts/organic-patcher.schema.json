{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.local/schemas/organic-patcher.schema.json",
  "title": "AURORA NEXUS Organic Patcher Manifest",
  "type": "object",
  "required": [
    "manifestId",
    "orgId",
    "clientSkillId",
    "platform",
    "baseVersion",
    "clientVersion",
    "mode",
    "patches",
    "security",
    "audit"
  ],
  "properties": {
    "manifestId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120
    },
    "orgId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "clientSkillId": {
      "type": "string",
      "minLength": 4,
      "maxLength": 120,
      "pattern": "^aurora-client-[a-z0-9_-]+$"
    },
    "platform": {
      "type": "string",
      "enum": ["web", "pwa", "desktop-macos", "desktop-windows", "ios", "android", "wrapper"]
    },
    "baseVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "clientVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "mode": {
      "type": "string",
      "enum": ["trial", "contracted", "hml", "production"]
    },
    "patches": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "patchId",
          "module",
          "reason",
          "operationNeed",
          "status",
          "requiresHumanReview",
          "rollbackAvailable"
        ],
        "properties": {
          "patchId": {
            "type": "string",
            "minLength": 4,
            "maxLength": 120
          },
          "module": {
            "type": "string",
            "enum": [
              "client_operation_skill",
              "gmail_domain_indexer_lgpd",
              "document_sanitation",
              "communication_robot",
              "billing_chain",
              "glosa_recovery",
              "money_drain_panel",
              "service_insight",
              "trial_friction_metrics",
              "notification_engine",
              "ui_dashboard",
              "audit_trail"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "operationNeed": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "status": {
            "type": "string",
            "enum": ["proposed", "synthetic_tested", "waiting_human_review", "approved", "applied", "rolled_back", "blocked"]
          },
          "requiresHumanReview": {
            "type": "boolean"
          },
          "rollbackAvailable": {
            "type": "boolean"
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "allowedSurfaces": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["web", "pwa", "desktop-macos", "desktop-windows", "ios", "android", "backend-only"]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "security": {
      "type": "object",
      "required": [
        "requiresAuth",
        "requiresAppCheck",
        "noClientSecrets",
        "denyByDefault",
        "lgpdScopeRequired",
        "backendOnlySensitiveActions"
      ],
      "properties": {
        "requiresAuth": { "type": "boolean", "const": true },
        "requiresAppCheck": { "type": "boolean", "const": true },
        "noClientSecrets": { "type": "boolean", "const": true },
        "denyByDefault": { "type": "boolean", "const": true },
        "lgpdScopeRequired": { "type": "boolean", "const": true },
        "backendOnlySensitiveActions": { "type": "boolean", "const": true }
      },
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "required": ["createdAt", "createdBy", "hash", "rollbackPolicy"],
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 120 },
        "hash": { "type": "string", "minLength": 16, "maxLength": 128 },
        "rollbackPolicy": {
          "type": "string",
          "enum": ["required", "not_applicable_read_only"]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
